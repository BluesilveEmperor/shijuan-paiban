      "commands": [
        "\\daan",
        "\\jieti",
        "\\xijie",
        "\\xiaoI",
        "\\xiaoII",
        "\\xiaoIII",
        "\\eqimg",
        "\\mi",
        "\\me"
      ],
      "required_packages": [
