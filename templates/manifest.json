      },
      "commands": {
        "\\examtitle[绝密★启用前]{考试名}{科目}": "试卷卷首（16pt 卷名 + 18pt 拉开字距的科目名）",
        "\\answertitle{考试名}{科目}": "参考答案卷首（16pt，两行）",
        "\\parttitle{第一部分 听力（共两节，满分 30 分）}": "一级大题标题（12pt 黑体）",
        "\\sectitle{第一节（共5小题…）}": "二级小节标题（10.5pt 粗体）",
