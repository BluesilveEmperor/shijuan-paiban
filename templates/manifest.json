        "\\cz{41}{A}{B}{C}{D}": "完形一行：题号 + 四选项（cloze 4 列）",
        "\\writinglines{10}": "写作作答空行（14pt 字 / 28pt 行距）",
        "\\writingpara{Paragraph 1: …}": "读后续写段落首句行",
        "\\answerline{1-5 BABCA}": "参考答案行",
        "\\blankanswer{56}{a}": "语法填空答案「56. a」",
        "\\rubricitem{…}": "评分细则条目（自动编号（1）（2）…）",
        "\\passagelabel{A}": "阅读文章编号（居中粗体）",
        "\\writingtitle{…}": "作文标题（居中粗体）"
      },
