% ============================================================================
%  answersheet.sty —— 高考 / 模拟考 / 联盟卷 通用答题卡宏包（v2.0）
%  原名 答题卡.sty；为跨平台可移植（Linux/macOS 中文文件名易失配）改为 ASCII 名。
%  调用方式：\usepackage{answersheet}
% ----------------------------------------------------------------------------
%  排版引擎：由「卷型数据」自动分页、自动分栏，不再逐页硬编码坐标。
%    · layout=a4|a3   a4：每面一个版面；a3：每张纸横排两个版面（对折成册）
%    · pages=N       版面总数（a4 即页数；a3 为张数，实际版面 = 2N）
%    · block=B       每面最多排几道解答题（1～3，控制题目密度）
%    · rules={15/13,16/15,17/15,18/17,19/17}
%                    解答题「题号/分值」序列；按分值比例自动分配各面高度，
%                    分值大的题自动占更多版面，装不下的题自动移到下一面
%    · choices=11 percol=4 blanks=3   选择题数量、每列题数、填空题数量
%    · title=… subject=… color=… bw=true|false
%    · 考生信息（试室号/座位号/姓名/班级/考生号填涂表/注意事项）只出现在首面，
%      其余版面为纯答题区，不再重复姓名、考生号。
% ----------------------------------------------------------------------------
%  注意：用 remember picture 定位，必须连续编译两次；改动版面后若位置异常，
%        先删除同名 .aux 再编译两次。
% ----------------------------------------------------------------------------
%  用法：在导言区 \usepackage{answersheet}，然后
%        \gkSetup{layout=a4,pages=4,block=2,...}
%        \begin{document} … \gkMake
%  示例见 A4答题卡.tex / A3答题卡.tex
% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{answersheet}[2026/10/28 v2.0 Answer sheet for Gaokao / mock / league exams]

\@ifpackageloaded{ctex}{}{\RequirePackage{ctex}}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{eso-pic}
\RequirePackage{lastpage}
\RequirePackage{fontspec}
\IfFontExistsTF{Times New Roman}{\setmainfont{Times New Roman}}{}

