\makeatletter
\newif\if@gkBW      \@gkBWfalse
\newif\if@gkAthree  \@gkAthreefalse
\pgfkeys{/gk/.is family}
\newcommand*\gkSetup[1]{\pgfkeys{/gk/.cd,#1}}
\pgfkeys{
  /gk/layout/.code     = {\def\gk@layout{#1}\def\gk@one{a4}%
                          \ifx\gk@layout\gk@one\@gkAthreefalse\else\@gkAthreetrue\fi},
  /gk/pages/.estore in = \gk@pages,
  /gk/block/.estore in = \gk@block,
  /gk/choices/.estore in=\gk@choices,
  /gk/percol/.estore in = \gk@percol,
  /gk/blanks/.estore in = \gk@blanks,
  /gk/rules/.estore in  = \gk@rules,
  /gk/title/.estore in  = \gk@title,
  /gk/subject/.estore in= \gk@subject,
  /gk/color/.code       = {\colorlet{GKmain}{#1}},
  /gk/bw/.is if         = @gkBW,
}
\gkSetup{layout=a4, pages=4, block=2,
         choices=11, percol=4, blanks=3,
