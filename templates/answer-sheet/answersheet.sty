\def\gkCanvasW{19.8}      % 版心宽  = 210mm - 2×6mm
\def\gkCanvasH{28.5}      % 版心高  = 297mm - 2×6mm
\def\gkselw{0.5}          % 填涂框宽
\def\gkselh{0.25}         % 填涂框高
\newlength\gkMargin  \setlength\gkMargin{6mm}
\newlength\gkPanelGap \setlength\gkPanelGap{21cm}   % a3 左右版面间距 = A4 纸宽

% --------------------------- 参数接口 ---------------------------
