% 考生号填涂表：#1 = 位数
\newcommand*\gkIDGrid[1]{%
\begin{scope}
  \def\cols{#1}\def\rows{10}
  \def\cellw{0.9}\def\cellh{0.5}
  \def\gx{9.5}\def\gy{24.2}\def\headh{0.6}\def\pad{0.2}
  \pgfmathsetmacro{\gbot}{\gy-\headh-\cellw-2*\pad-\rows*\cellh}
  \foreach \c in {0,...,\cols}{\draw[GKmain] (\gx+\c*\cellw,\gy-\headh) -- (\gx+\c*\cellw,\gbot);}
  \draw[GKmain] (\gx,\gy) -- (\gx+\cols*\cellw,\gy);
  \draw[GKmain] (\gx,\gy-\headh) -- (\gx+\cols*\cellw,\gy-\headh);
  \draw[GKmain] (\gx,\gy-\headh-\cellw) -- (\gx+\cols*\cellw,\gy-\headh-\cellw);
  \draw[GKmain] (\gx,\gbot) -- (\gx+\cols*\cellw,\gbot);
  \draw[GKmain] (\gx,\gy) -- (\gx,\gy-\headh);
  \draw[GKmain] (\gx+\cols*\cellw,\gy) -- (\gx+\cols*\cellw,\gy-\headh);
  \node[font=\small\bfseries] at (\gx+0.5*\cols*\cellw,\gy-0.5*\headh) {考\hspace{1em}生\hspace{1em}号};
  \foreach \r in {1,...,\rows}{%
    \pgfmathsetmacro{\cy}{\gy-\headh-\cellw-\pad-\r*\cellh+0.5*\cellh}
    \begingroup
      \def\gkselw{0.55}\def\gkselh{0.26}%
      \foreach \c in {1,...,\cols}{%
        \pgfmathsetmacro{\cx}{\gx+\c*\cellw-0.5*\cellw}%
        \node[font=\footnotesize, text=GKmain] at (\cx,\cy) {\the\numexpr\r-1\relax};%
        \gkBracket{\cx}{\cy}}%
    \endgroup
    \gkMark{18.9}{\cy}}
\end{scope}}

% 注意事项框
\newcommand*\gkNoticeBox{%
\begin{scope}
  \def\sx{1.2}\def\sy{24.2}\def\sw{7.7}\def\sh{4.8}
  \draw[GKmain] (\sx,\sy) rectangle ++(\sw,-\sh);
  \node[text width=7.3cm, align=left, anchor=north west,
        font=\fontsize{8pt}{9.5pt}\selectfont] at (\sx+0.1,\sy-0.1) {%
      \textbf{注意事项：}\\
      \hangindent=1.4em 1．答题前，考生务必用黑色字迹的钢笔或签字笔将试室号、座位号、姓名和考生号填写在答题卡上，并用\hspace{0.1em}2B\hspace{0.1em}铅笔将考生号对应的数字涂黑。\\
      \hangindent=1.4em 2．回答选择题时，选出每小题答案以后，用\hspace{0.1em}2B\hspace{0.1em}铅笔把答题卡上对应题目的答案标号涂黑。如需改动，用橡皮擦擦干净后，再选其它答案标号涂黑。回答非选择题时，将答案写在答题卡上指定区域内，超出答题区域的答案无效。\\
      \hangindent=1.4em 3．正确填涂试卷类型，否则答案无效。\\
      \hangindent=1.4em 4．答题卡保持卡面整洁，不要折叠和弄破。};
\end{scope}}
