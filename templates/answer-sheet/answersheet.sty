% ---------- 题目附图 / 三线表 ----------
% 用法（写在 \begin{document} 之后、\gkMake 之前）：
%   \gkFig{16}{\begin{tikzpicture}...\end{tikzpicture}}   % 右上角小图
%   \gkBlock{19}{\begin{tabular}{...}...\end{tabular}}   % 顶部通栏（宽表）
% 参数是【题号】，不是第几道。必须用 \long 版本：图表内容里常有空行，
% 短宏（\newcommand*）遇到 \par 会报 "Paragraph ended before ... was complete"。
\def\gk@figw{6cm}       % 角图容器宽度
\def\gk@blkw{15cm}      % 通栏块容器宽度
% 用固定宽度的 minipage 承载内容：
%   · minipage 内部是竖直模式，原卷里的 center / 多行 / 表格都能正常工作
%     （\sbox 是 LR 模式，一遇到 \begin{center} 就报 "Not allowed in LR mode"）；
%   · 内容里的 \textwidth / \linewidth 会随容器收窄，0.32\textwidth 的并排图自动缩小。
% 内容用固定宽度的 minipage 承载：minipage 内部是竖直模式，原卷里的
% center / 多行 / 表格都能正常工作（\sbox 是 LR 模式，遇到 \begin{center} 就报错）；
% 内容里的 \textwidth / \linewidth 会随容器收窄，0.32\textwidth 的并排图自动缩小。
% 高度不在这里做缩放——是否放得下由 gen_answer_sheet.py 在生成前算好，
% 放不下就自动降密度（每题独占一面），比 TeX 现场量高度可靠得多。
\newcommand*\gk@fit[2]{%
  \begin{minipage}{#1}\centering #2\end{minipage}}
\newcommand\gkFig[2]{\expandafter\gdef\csname gk@fig@#1\endcsname{#2}}
\newcommand\gkBlock[2]{\expandafter\gdef\csname gk@blk@#1\endcsname{#2}}
\makeatother
% ============================================================================
%  排版引擎
% ============================================================================
\makeatletter
% ---------- 解析 rules：题号 / 分值 / 分值前缀和 ----------
% 注意：附图高度【不】参与分页计算。图只占作答区顶部，挤掉的是书写空间，
% 不改变「哪几题同页」——若把图高折成分数，19 题卷会从 1+2+1+1 变成 1+1+1+2，
% 末页硬塞两道 17 分大题，反而更难写。空间不够请用 --pages / --block 调。
\newcounter{gk@i}
\newcommand*\gk@parse{%
  \setcounter{gk@i}{0}\def\gk@acc{0}%
  \expandafter\xdef\csname gk@pfx0\endcsname{0}%
  \foreach \q/\sc in \gk@rules{%
    \stepcounter{gk@i}%
    \expandafter\xdef\csname gk@q\arabic{gk@i}\endcsname{\q}%
    \expandafter\xdef\csname gk@s\arabic{gk@i}\endcsname{\sc}%
    \xdef\gk@acc{\the\numexpr\gk@acc+\sc\relax}%
    \expandafter\xdef\csname gk@pfx\arabic{gk@i}\endcsname{\gk@acc}}%
  \xdef\gk@N{\arabic{gk@i}}%
  \xdef\gk@total{\gk@acc}}

% ---------- 版面规划 ----------
% 第 #1 面可排版高度（cm）：只有首面被考生信息/选择题/填空题占用，其余整面用于解答题
\newcommand*\gk@Hget[1]{%
  \ifnum#1=0 \def\gk@Ht{\gk@Hzero}\else \def\gk@Ht{\gk@plainH}\fi}
% 把解答题按分值比例装进各版面：每面目标分值与其可用高度成正比
\newcommand*\gk@plan{%
  \pgfmathsetmacro{\gk@Htot}{\gk@Hzero+(\gk@npanels-1)*\gk@plainH}%
  \def\gk@qi{0}%
  \foreach \i in {0,...,\numexpr\gk@npanels-1\relax}{%
    \gk@Hget{\i}%
    \edef\gk@psv{\csname gk@pfx\gk@qi\endcsname}%
    \ifnum\i=\numexpr\gk@npanels-1\relax
      \xdef\gk@e{\gk@N}%
    \else
      \pgfmathsetmacro{\gk@tgt}{\gk@Ht/\gk@Htot*\gk@total}%
      \xdef\gk@e{\gk@qi}\xdef\gk@cnt{0}\xdef\gk@go{1}%
      \foreach \k in {1,...,\gk@N}{%
        \ifnum\gk@go=1
          \ifnum\k>\gk@qi
            \ifnum\gk@cnt<\gk@block
              \ifnum\gk@cnt=0
                \xdef\gk@e{\k}\xdef\gk@cnt{1}%
              \else
                \edef\gk@mbv{\csname gk@pfx\the\numexpr\k-1\relax\endcsname}%
                \edef\gk@sv{\csname gk@s\k\endcsname}%
                \pgfmathsetmacro{\gk@mb}{\gk@mbv-\gk@psv+\gk@sv/2}%
                \pgfmathtruncatemacro{\gk@ok}{\gk@mb<\gk@tgt?1:0}%
                \ifnum\gk@ok=1
                  \xdef\gk@e{\k}\xdef\gk@cnt{\the\numexpr\gk@cnt+1\relax}%
                \else \xdef\gk@go{0}\fi
              \fi
            \else \xdef\gk@go{0}\fi
          \fi
        \fi
      }%
    \fi
    \expandafter\xdef\csname gk@ps\i\endcsname{\gk@qi}%
    \expandafter\xdef\csname gk@pe\i\endcsname{\gk@e}%
    \xdef\gk@qi{\gk@e}}%
}

% ---------- 判定当前版面的框线与答题区高度 ----------
\newcommand*\gk@PageSetup{%
  \ifnum\gk@pageNo=0
    \def\gk@bigtop{\gk@zeroBig}\def\gk@top{\gk@answertop}%
  \else
    \def\gk@bigtop{\gk@plainBig}\def\gk@top{\gk@plainTop}%
  \fi}

% ---------- 画本版面的解答题：分隔线 + 题号标签 + 附图 ----------
% 附图：#1 第几道解答题，#2 该题答题区上边纵坐标
\newcommand*\gk@DrawAux[2]{%
  \ifcsname gk@fig@#1\endcsname
    \node[anchor=north east, inner sep=2pt] at (18.25,#2-0.12)
      {\gk@fit{\gk@figw}{\csname gk@fig@#1\endcsname}};%
  \fi
  \ifcsname gk@blk@#1\endcsname
    \node[anchor=north, inner sep=2pt] at (9.85,#2-0.80)
      {\gk@fit{\gk@blkw}{\csname gk@blk@#1\endcsname}};%
  \fi}
\newcommand*\gk@DrawPage{%
  \def\gk@qi{\csname gk@ps\gk@pageNo\endcsname}%
  \def\gk@qe{\csname gk@pe\gk@pageNo\endcsname}%
  \ifnum\gk@qe>\gk@qi
    \edef\gk@psv{\csname gk@pfx\gk@qi\endcsname}%
    \edef\gk@pev{\csname gk@pfx\gk@qe\endcsname}%
    \pgfmathsetmacro{\gk@mk}{\gk@pev-\gk@psv}%
    \pgfmathsetmacro{\gk@sca}{(\gk@top-1.2)/\gk@mk}%
    \foreach \k in {1,...,\gk@N}{%
      \ifnum\k>\gk@qi
        \ifnum\k<\numexpr\gk@qe+1\relax
          \edef\gk@prev{\csname gk@pfx\the\numexpr\k-1\relax\endcsname}%
          \pgfmathsetmacro{\gk@yy}{\gk@top-(\gk@prev-\gk@psv)*\gk@sca}%
          \gkQLabel{\csname gk@q\k\endcsname}{\csname gk@s\k\endcsname}{2.7}{\gk@yy-0.42}%
          \gk@DrawAux{\csname gk@q\k\endcsname}{\gk@yy}%
          \ifnum\k>\numexpr\gk@qi+1\relax\gkDivider{\gk@yy}\fi
        \fi
      \fi
    }%
  \fi}

% ---------- 单个版面的全部内容 ----------
\newcommand*\gk@PageContent{%
  \gk@PageSetup
  \ifnum\gk@pageNo=0
    \gkHeaderFull
    \gkChoice{1}{\gk@choices}{\gk@percol}%
    \gkBlank{\numexpr\gk@choices+1\relax}{\gk@blanks}{\gk@blanktop}%
    \gkSectionTitle{三、解答题}{1.5}{\gk@answertop+1.0}%
  \fi
  \gkFrame{\gk@bigtop}%
  \gkInnerFrame{\gk@top}{1.2}%
  \gk@DrawPage
  \gkWarn{9.9}{0.9}%
  \ifnum\gk@pageNo=0\else\gkWarn{9.9}{\gk@bigtop+0.5}\fi
  \node[text=GKmain, font=\bfseries] at (0.5*\gkCanvasW,0.25) {\gk@footertext};}

% ---------- 页脚 ----------
\newcommand*\gk@footertext{\gk@subject 答题卡\quad 第 \thepage\ 
  \if@gkAthree 张\else 页\fi（共 \pageref{LastPage}\ \if@gkAthree 张\else 页\fi）}
\newcommand*\gk@hook{%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[black] ([xshift=\gkMargin,  yshift=\gkMargin] current page.south west) rectangle ++(10mm,6mm);
    \fill[black] ([xshift=-\gkMargin, yshift=\gkMargin] current page.south east) rectangle ++(-10mm,6mm);
    \fill[black] ([xshift=-\gkMargin, yshift=-\gkMargin] current page.north east) rectangle ++(-10mm,-6mm);
    \fill[black] ([xshift=\gkMargin,  yshift=-\gkMargin] current page.north west) rectangle ++(10mm,-6mm);
  \end{tikzpicture}}

% ---------- 主入口 ----------
\newlength\gkPanelShift
\newcommand*\gkMake{%
  \gk@parse
  \if@gkAthree
    \def\gk@devices{2}\pgfmathtruncatemacro{\gk@npanels}{\gk@pages*2}%
  \else
    \def\gk@devices{1}\def\gk@npanels{\gk@pages}%
  \fi
  % 版面尺寸推算（单位 cm，原点在版心左下角）
  \pgfmathtruncatemacro{\gk@cnrows}{min(\gk@choices,\gk@percol)}%
  \pgfmathsetmacro{\gk@choiceH}{\gk@cnrows*0.55+0.5}%
  \pgfmathsetmacro{\gk@blanktop}{16.2-\gk@choiceH-0.7}%
  \pgfmathtruncatemacro{\gk@brows}{ceil(\gk@blanks/3)}%
  \pgfmathsetmacro{\gk@blankH}{\gk@brows*1.2+0.2}%
  \pgfmathsetmacro{\gk@answertop}{\gk@blanktop-\gk@blankH-1.2}%
  \pgfmathsetmacro{\gk@zeroBig}{\gk@answertop+0.5}%
  \def\gk@plainTop{26.9}\def\gk@plainBig{27.5}%
  \pgfmathsetmacro{\gk@Hzero}{\gk@answertop-1.2}%
  \def\gk@plainH{25.7}%
  \gk@plan
  \AddToShipoutPictureFG{\gk@hook}%
  \foreach \sh in {0,...,\numexpr\gk@pages-1\relax}{%
    \foreach \dv in {0,...,\numexpr\gk@devices-1\relax}{%
      \xdef\gk@pageNo{\the\numexpr\sh*\gk@devices+\dv\relax}%
      \setlength\gkPanelShift{\gkMargin}%
      \ifnum\dv=1 \setlength\gkPanelShift{\dimexpr\gkMargin+\gkPanelGap\relax}\fi
      \begin{tikzpicture}[remember picture, overlay, x=1cm, y=1cm,
        shift={([xshift=\gkPanelShift,
                  yshift=\gkMargin]current page.south west)}]
        \gk@PageContent
      \end{tikzpicture}%
    }%
    \clearpage
  }%
}
\makeatother
