         title=2025年普通高等学校招生全国统一考试, subject=数学,
         color=GKpink, bw=false}
\if@gkBW \colorlet{GKmain}{black}\fi
\makeatother
% --------------------------- 基本图元 ---------------------------
% 涂黑填涂框（#1#2 为中心）
\newcommand*\gkMark[2]{%
  \fill[black] ($(#1,#2)+(-\gkselw/2,\gkselh/2)$) rectangle ($(#1,#2)+(\gkselw/2,-\gkselh/2)$);}
% 空心填涂框
\newcommand*\gkBox[2]{%
  \draw[GKmain] ($(#1,#2)+(-\gkselw/2,\gkselh/2)$) rectangle ($(#1,#2)+(\gkselw/2,-\gkselh/2)$);}
% 中括号填涂框（考生作答区）
\newcommand*\gkBracket[2]{%
  \draw[GKmain] ($(#1,#2)+(-0.25*\gkselw,0.5*\gkselh)$) -- ($(#1,#2)+(-0.5*\gkselw,0.5*\gkselh)$)
             -- ($(#1,#2)+(-0.5*\gkselw,-0.5*\gkselh)$) -- ($(#1,#2)+(-0.25*\gkselw,-0.5*\gkselh)$);
  \draw[GKmain] ($(#1,#2)+(0.25*\gkselw,0.5*\gkselh)$) -- ($(#1,#2)+(0.5*\gkselw,0.5*\gkselh)$)
             -- ($(#1,#2)+(0.5*\gkselw,-0.5*\gkselh)$) -- ($(#1,#2)+(0.25*\gkselw,-0.5*\gkselh)$);}
% 上边缘定位标记带：#1 个数 #2 起点横坐标 #3 间距
\newcommand*\gkTopMarks[3]{%
  \foreach \i in {0,...,\numexpr#1-1\relax}{\gkMark{#2+\i*#3}{28.1}}}
% 小节标题
\newcommand*\gkSectionTitle[3]{%
  \node[anchor=north west, align=left, font=\fontsize{10.5pt}{12pt}\selectfont]
    at (#2,#3) {\bfseries #1};}

% --------------------------- 选择题区 ---------------------------
% #1 起始题号  #2 数量  #3 每列题数
\newcommand*\gkChoice[3]{%
\begin{scope}
  \def\bx{1.4}\def\by{16.2}\def\bw{16.9}
  \def\rowsep{0.55}\def\xstep{4.35}\def\labgap{0.8}\def\optgap{0.72}
  \pgfmathtruncatemacro{\nrows}{min(#2,#3)}
  \pgfmathsetmacro{\bh}{\nrows*\rowsep+0.5}
  \pgfmathtruncatemacro{\ncols}{ceil(#2/#3)}
  \draw[black] (\bx,\by) rectangle ++(\bw,-\bh);
  \gkSectionTitle{一、选择题}{\bx+0.1}{\by+0.6}
  \foreach \i in {0,...,\numexpr#2-1\relax}{
    \pgfmathtruncatemacro{\q}{\i+#1}
    \pgfmathtruncatemacro{\c}{floor(\i/#3)}
    \pgfmathtruncatemacro{\r}{mod(\i,#3)}
    \pgfmathsetmacro{\qx}{1.9+\c*\xstep}
    \pgfmathsetmacro{\qy}{\by-0.53-\r*\rowsep}
    \node at (\qx,\qy) {\q};
    \foreach \k/\L in {0/A,1/B,2/C,3/D}{
      \pgfmathsetmacro{\lx}{\qx+\labgap+\k*\optgap}
      \node[font=\footnotesize, text=GKmain] at (\lx,\qy) {\L};
      \gkBracket{\lx}{\qy}}}
  \foreach \r in {0,...,\numexpr\nrows-1\relax}{
    \pgfmathsetmacro{\qy}{\by-0.53-\r*\rowsep}
    \gkMark{0.85}{\qy}\gkMark{18.85}{\qy}}
\end{scope}}

% --------------------------- 填空题区 ---------------------------
% #1 起始题号  #2 数量  #3 框上边纵坐标
\newcommand*\gkBlank[3]{%
\begin{scope}
  \def\bx{1.4}\def\bw{16.9}
  \pgfmathtruncatemacro{\nrows}{ceil(#2/3)}
  \pgfmathsetmacro{\bh}{\nrows*1.2+0.2}
  \draw[black] (\bx,#3) rectangle ++(\bw,-\bh);
  \gkSectionTitle{二、填空题}{\bx+0.1}{#3+0.6}
  \foreach \i in {0,...,\numexpr#2-1\relax}{
    \pgfmathtruncatemacro{\c}{mod(\i,3)}
    \pgfmathtruncatemacro{\r}{floor(\i/3)}
    \pgfmathsetmacro{\qx}{1.9+\c*4.35+0.1}
    \pgfmathsetmacro{\qy}{#3-0.8-\r*1.2}
    \node at (\qx,\qy) {\the\numexpr\i+#1\relax.};
    \draw[GKmain] (\qx+0.3,\qy-0.2) -- ++(3.55,0);}
\end{scope}}
