{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "地理试卷排版统一数据契约",
  "description": "v3.0 六步解耦流水线的统一数据格式。覆盖从结构打标到图片映射到排版的全链路数据。",
  "type": "object",
  "required": ["meta", "document", "images", "image_mapping", "validation"],
  "properties": {
    "meta": {
      "type": "object",
      "description": "试卷元信息",
      "required": ["title", "subject", "source_file"],
      "properties": {
        "title": {
          "type": "string",
          "description": "试卷标题，如'2025年普通高等学校招生全国统一考试（新课标卷）'"
        },
        "subtitle": {
          "type": "string",
          "description": "副标题（可选）"
        },
        "subject": {
          "type": "string",
          "description": "科目名称",
          "enum": ["地理"]
        },
        "grade": {
          "type": "string",
          "description": "年级/学段，如'高三'、'高考'"
        },
        "source_file": {
          "type": "string",
          "description": "原始试卷文件路径"
        },
        "notes": {
          "type": "string",
          "description": "试卷说明/注意事项全文（兼容旧格式，新格式使用 notes_items）"
        },
        "notes_items": {
          "type": "array",
          "description": "注意事项的结构化条目数组（新格式）",
          "items": {
            "type": "object",
            "required": ["type", "content"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["title", "item"],
                "description": "条目类型：title 为注意事项标题（如'注意事项'），item 为具体条目（如'1.作答前...'）"
              },
              "content": {
                "type": "string",
                "description": "条目内容"
              },
              "number": {
                "type": "string",
                "description": "条目标号（如'1'、'2'），仅 type=item 时有值"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "document": {
      "type": "object",
      "description": "试卷文档结构",
      "required": ["sections", "unclassified_blocks"],
      "properties": {
        "sections": {
          "type": "array",
          "description": "试卷分区（如选择题区、非选择题区）",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "type", "title", "questions"],
            "properties": {
              "id": {
                "type": "string",
                "description": "分区唯一标识，如'section_01'",
                "pattern": "^section_\\d{3}$"
              },
              "type": {
                "type": "string",
                "description": "分区类型",
                "enum": ["选择题", "非选择题", "填空题", "综合题"]
              },
              "title": {
                "type": "string",
                "description": "分区题型标题，如'一、选择题：本题共15小题...'。当仅有卷标题而无独立题型标题时（如只有'第I卷'无'一、选择题'），可填空字符串 ''"
              },
              "header_blocks": {
                "type": "array",
                "description": "分区头部内容块（出现在 title 之前的内容），按原文顺序排列。用于处理试卷中灵活的组织形式：卷标题、注意事项、说明文字等。无额外头部内容时为空数组",
                "items": {
                  "type": "object",
                  "required": ["type", "content"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "description": "块类型",
                      "enum": ["volume_title", "notes", "instructions"]
                    },
                    "content": {
                      "type": "string",
                      "description": "块内容原文"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "instructions": {
                "type": "array",
                "description": "分区说明/引导语",
                "items": { "type": "string" }
              },
              "questions": {
                "type": "array",
                "description": "该分区下的题目列表",
                "minItems": 1,
                "items": { "$ref": "#/definitions/question" }
              }
            },
            "additionalProperties": false
          }
        },
        "unclassified_blocks": {
          "type": "array",
          "description": "无法归类的文本块（兜底字段，空数组表示全部归类成功）",
          "items": {
            "type": "object",
            "required": ["id", "text", "reason"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^unclassified_\\d{3}$"
              },
              "text": {
                "type": "string",
                "description": "无法归类的原始文本"
              },
              "reason": {
                "type": "string",
                "description": "无法归类的原因",
                "enum": [
                  "题号丢失或乱序",
                  "选项与题干粘连",
                  "多栏文本串行化",
                  "表格被拆成纯文本",
                  "OCR识别异常",
                  "格式严重混乱",
                  "未知结构"
                ]
              },
              "notes": {
                "type": "string",
                "description": "补充说明"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "images": {
      "type": "array",
      "description": "图片理解结果列表",
      "items": {
        "type": "object",
        "required": ["image_id", "file_name", "type", "summary", "keywords", "uncertain"],
        "properties": {
          "image_id": {
            "type": "string",
            "description": "图片唯一标识",
            "pattern": "^img_\\d{3}$"
          },
          "file_name": {
            "type": "string",
            "description": "图片文件名（含扩展名），如'1.png'"
          },
          "type": {
            "type": "string",
            "description": "图片类型",
            "enum": [
              "地图",
              "统计图表",
              "示意图",
              "景观图",
              "卫星图",
              "表格图",
              "等高线图",
              "剖面图",
              "流程图",
              "其他"
            ]
          },
          "summary": {
            "type": "string",
            "description": "图片内容摘要"
          },
          "keywords": {
            "type": "array",
            "description": "关键词列表",
            "items": { "type": "string" }
          },
          "ocr_text": {
            "type": "array",
            "description": "OCR识别出的文字",
            "items": { "type": "string" }
          },
          "discipline_features": {
            "type": "array",
            "description": "学科特征标签（如'等值线'、'区域定位'、'气候类型'）",
            "items": { "type": "string" }
          },
          "clues": {
            "type": "array",
            "description": "与试题可能相关的线索",
            "items": { "type": "string" }
          },
          "uncertain": {
            "type": "boolean",
            "description": "图片理解是否不确定（兜底字段）"
          }
        },
        "additionalProperties": false
      }
    },

    "image_mapping": {
      "type": "array",
      "description": "占位符→图片的映射表",
      "items": {
        "type": "object",
        "required": ["placeholder_id", "image_id", "confidence", "reason"],
        "properties": {
          "placeholder_id": {
            "type": "string",
            "description": "引用的占位符ID",
            "pattern": "^(?:ph_(?:anchor_)?\\d{3}|img_\\d{3})$"
          },
          "image_id": {
            "type": "string",
            "description": "引用的图片ID",
            "pattern": "^img_\\d{3}$"
          },
          "confidence": {
            "type": "number",
            "description": "映射置信度 0.0~1.0",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "reason": {
            "type": "string",
            "description": "匹配依据说明"
          },
          "track": {
            "type": "string",
            "description": "映射来源标识",
            "enum": ["code", "ai"]
          }
        },
        "additionalProperties": false
      }
    },

    "validation": {
      "type": "object",
      "description": "校验信息",
      "required": ["has_unmapped_placeholders", "has_unused_images", "unmapped_placeholders", "unused_images", "warnings"],
      "properties": {
        "has_unmapped_placeholders": {
          "type": "boolean",
          "description": "是否有未映射的占位符"
        },
        "has_unused_images": {
          "type": "boolean",
          "description": "是否有未使用的图片"
        },
        "unmapped_placeholders": {
          "type": "array",
          "description": "未映射的占位符ID列表",
          "items": { "type": "string" }
        },
        "unused_images": {
          "type": "array",
          "description": "未使用的图片ID列表",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "description": "警告信息列表",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,

  "definitions": {
    "question": {
      "type": "object",
      "description": "单道题目",
      "required": ["id", "number", "stem", "question_type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "题目唯一标识",
          "pattern": "^question_\\d{3}$"
        },
        "number": {
          "type": "string",
          "description": "题号（可能含括号），如'1'、'(1)'"
        },
        "question_type": {
          "type": "string",
          "description": "题目类型",
          "enum": ["选择题", "非选择题", "填空题"]
        },
        "stem": {
          "type": "string",
          "description": "题干内容（不含占位符的纯文本，占位符在placeholders中）"
        },
        "materials": {
          "type": "array",
          "description": "题目材料（如材料题中的大段阅读材料）",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^material_\\d{3}(_\\d+)?$"
              },
              "order": {
                "type": "integer",
                "description": "在题目内的渲染顺序（1-based），与 subquestions 的 order 混合排序后得到最终渲染序列。无此字段时按数组顺序渲染在所有子问题之前。"
              },
              "title": {
                "type": "string",
                "description": "材料标题（可选），如'材料一'、'材料二'、'【研学背景】'等。提取后 content 中不再包含标题。"
              },
              "title_style": {
                "type": "string",
                "description": "标题排版样式。inline=标题与正文同行，排版时自动添加【】；block=标题单独一行。仅 title 非空时有意义。",
                "enum": ["inline", "block"]
              },
              "content": {
                "type": "string",
                "description": "材料正文（不包含引导语和标题）- 当使用segments时可为空，由segments提供内容"
              },
              "guide_sentence": {
                "type": "string",
                "description": "材料末尾的引导语句，如'据此完成下面小题'、'完成下列要求'等，用于紧跟材料后单独设置字体样式"
              },
              "segments": {
                "type": "array",
                "description": "材料的分段内容（可包含文本、图片、表格），按出现顺序排列",
                "items": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "description": "内容段类型",
                      "enum": ["text", "image", "table"]
                    },
                    "content": {
                      "type": "string",
                      "description": "文本内容（type=text时必需）"
                    },
                    "name": {
                      "type": "string",
                      "description": "图片文件名（type=image时必需），如'img_001.png'"
                    },
                    "data": {
                      "type": "object",
                      "description": "表格数据（type=table时必需）",
                      "required": ["rows", "cols", "data"],
                      "properties": {
                        "table_id": {
                          "type": "string",
                          "description": "表格唯一标识（如 table_001）"
                        },
                        "rows": {
                          "type": "integer",
                          "description": "表格行数",
                          "minimum": 1
                        },
                        "cols": {
                          "type": "integer",
                          "description": "表格列数",
                          "minimum": 1
                        },
                        "data": {
                          "type": "array",
                          "description": "表格数据（二维数组，rows行cols列）",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "spans": {
                          "type": "array",
                          "description": "单元格合并信息。无合并时为[]。每个条目描述一个合并区域。",
                          "items": {
                            "type": "object",
                            "required": ["row", "col", "rowspan", "colspan"],
                            "properties": {
                              "row": {
                                "type": "integer",
                                "description": "合并起始行（0-based）",
                                "minimum": 0
                              },
                              "col": {
                                "type": "integer",
                                "description": "合并起始列（0-based）",
                                "minimum": 0
                              },
                              "rowspan": {
                                "type": "integer",
                                "description": "纵向合并行数",
                                "minimum": 1
                              },
                              "colspan": {
                                "type": "integer",
                                "description": "横向合并列数",
                                "minimum": 1
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "header_rows": {
                          "type": "integer",
                          "description": "表头行数（0=无表头，1=首行表头，2=前两行表头等）",
                          "minimum": 0,
                          "default": 0
                        },
                        "table_role": {
                          "type": "string",
                          "description": "表格角色",
                          "enum": ["data", "layout", "material", "answer", "mixed", "unknown"],
                          "default": "unknown"
                        },
                        "table_style": {
                          "type": "string",
                          "description": "表格样式",
                          "enum": ["grid", "plain", "preserve"],
                          "default": "grid"
                        },
                        "has_header": {
                          "type": "boolean",
                          "description": "（已废弃，使用 header_rows 替代）是否有表头行",
                          "default": false
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "options": {
          "type": "array",
          "description": "选项列表（选择题必需）",
          "items": {
            "type": "object",
            "required": ["label", "text"],
            "properties": {
              "label": {
                "type": "string",
                "description": "选项标签，如'A'、'B'"
              },
              "text": {
                "type": "string",
                "description": "选项内容"
              }
            },
            "additionalProperties": false
          }
        },
        "sub_options": {
          "type": "array",
          "description": "选择题子选项列表（如①②③④）",
          "items": {
            "type": "object",
            "required": ["label", "text"],
            "properties": {
              "label": {
                "type": "string",
                "description": "子选项标签，如'①'、'②'"
              },
              "text": {
                "type": "string",
                "description": "子选项内容"
              }
            },
            "additionalProperties": false
          }
        },
        "subquestions": {
          "type": "array",
          "description": "子问题（大题下的小问）",
          "items": {
            "type": "object",
            "required": ["id", "label", "stem"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^subq_\\d{3}(_\\d+)?$"
              },
              "label": {
                "type": "string",
                "description": "小问标签，如'(1)'、'(2)'"
              },
              "order": {
                "type": "integer",
                "description": "在题目内的渲染顺序（1-based），与 materials 的 order 混合排序后得到最终渲染序列。无此字段时按数组顺序渲染在所有材料之后。"
              },
              "sub_question_type": {
                "type": "string",
                "enum": ["essay", "fill_in_blank", "mixed"],
                "default": "essay",
                "description": "子问题类型：essay=论述题，fill_in_blank=填空题（stem 中含____），mixed=混合型（同时含____和完整问句）"
              },
              "stem": {
                "type": "string",
                "description": "小问题干"
              },
              "materials": {
                "type": "array",
                "description": "子问题专属材料（如表格、图片等）。仅服务于该子问题，结构与问题级 materials 相同。",
                "items": {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^material_\\d{3}(_\\d+)?$"
                    },
                    "title": {
                      "type": "string",
                      "description": "材料标题（可选）"
                    },
                    "title_style": {
                      "type": "string",
                      "description": "标题排版样式",
                      "enum": ["inline", "block"]
                    },
                    "content": {
                      "type": "string",
                      "description": "材料正文"
                    },
                    "guide_sentence": {
                      "type": "string",
                      "description": "材料末尾引导语句"
                    },
                    "segments": {
                      "type": "array",
                      "description": "材料分段内容（可含表格）",
                      "items": {
                        "type": "object",
                        "required": ["type"],
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": ["text", "image", "table"]
                          },
                          "content": {
                            "type": "string",
                            "description": "文本内容"
                          },
                          "name": {
                            "type": "string",
                            "description": "图片文件名"
                          },
                          "data": {
                            "type": "object",
                            "description": "表格数据",
                            "required": ["rows", "cols", "data"],
                            "properties": {
                              "table_id": {"type": "string", "description": "表格唯一标识"},
                              "rows": {"type": "integer", "minimum": 1},
                              "cols": {"type": "integer", "minimum": 1},
                              "data": {
                                "type": "array",
                                "description": "表格数据（二维数组，rows行cols列）",
                                "items": {"type": "array", "items": {"type": "string"}}
                              },
                              "spans": {
                                "type": "array",
                                "description": "单元格合并信息。无合并时为[]。",
                                "items": {
                                  "type": "object",
                                  "required": ["row", "col", "rowspan", "colspan"],
                                  "properties": {
                                    "row": {"type": "integer", "minimum": 0},
                                    "col": {"type": "integer", "minimum": 0},
                                    "rowspan": {"type": "integer", "minimum": 1},
                                    "colspan": {"type": "integer", "minimum": 1}
                                  },
                                  "additionalProperties": false
                                }
                              },
                              "header_rows": {
                                "type": "integer", "description": "表头行数", "minimum": 0, "default": 0
                              },
                              "table_role": {
                                "type": "string", "description": "表格角色",
                                "enum": ["data", "layout", "material", "answer", "mixed", "unknown"],
                                "default": "unknown"
                              },
                              "table_style": {
                                "type": "string", "description": "表格样式",
                                "enum": ["grid", "plain", "preserve"], "default": "grid"
                              },
                              "has_header": {
                                "type": "boolean", "description": "（已废弃）是否有表头行", "default": false
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "placeholders": {
          "type": "array",
          "description": "该题关联的图片占位符",
          "items": {
            "type": "object",
            "required": ["placeholder_id", "token", "location_type", "owner_id", "context_before", "context_after", "reason"],
            "properties": {
              "placeholder_id": {
                "type": "string",
                "description": "占位符唯一标识",
                "pattern": "^(?:ph_(?:anchor_)?|img_)\\d{3}$"
              },
              "token": {
                "type": "string",
                "description": "占位符标记文本",
                "pattern": "^\\{\\{image:(?:ph_(?:anchor_)?|img_)\\d{3}\\}\\}$"
              },
              "location_type": {
                "type": "string",
                "description": "占位符所在位置类型",
                "enum": ["title", "material", "question_stem", "subquestion", "option"]
              },
              "owner_id": {
                "type": "string",
                "description": "占位符所属节点的ID（question.id / material.id / subq.id）"
              },
              "context_before": {
                "type": "string",
                "description": "占位符前文（20字以内）"
              },
              "context_after": {
                "type": "string",
                "description": "占位符后文（20字以内）"
              },
              "reason": {
                "type": "string",
                "description": "插入占位符的依据（如'正文提到如图'、'题干含等值线判读需要插图'）"
              },
              "_source": {
                "type": "string",
                "description": "占位符来源标识（v3.5双轨分流）",
                "enum": ["inline", "anchor"]
              },
              "_ai_reason": {
                "type": "string",
                "description": "AI判断依据（anchor图专用，记录AI如何确定图片位置）"
              },
              "uncertain": {
                "type": "boolean",
                "description": "占位是否不确定（无法确定此处是否需要图片）",
                "default": false
              }
            },
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "string",
          "description": "打标备注（当 uncertain 时必填）"
        },
        "uncertain": {
          "type": "boolean",
          "description": "该题结构识别是否不确定（兜底字段）",
          "default": false
