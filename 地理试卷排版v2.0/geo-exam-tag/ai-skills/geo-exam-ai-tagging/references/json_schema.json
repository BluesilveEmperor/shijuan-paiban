{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "地理试卷打标JSON Schema",
  "type": "object",
  "required": ["exam_info", "sections"],
  "properties": {
    "exam_info": {
      "type": "object",
      "required": ["exam_name", "subject"],
      "properties": {
        "exam_name": {
          "type": "string",
          "description": "考试完整名称"
        },
        "subject": {
          "type": "string",
          "enum": ["地理"],
          "description": "科目名称"
        },
        "notes": {
          "type": "string",
          "description": "注意事项内容"
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["section_id", "section_type", "question_groups"],
        "properties": {
          "section_id": {
            "type": "integer",
            "minimum": 1,
            "description": "分区编号"
          },
          "section_title": {
            "type": "string",
            "description": "分区标题"
          },
          "section_type": {
            "type": "string",
            "enum": ["选择题", "非选择题", "填空题"],
            "description": "分区类型"
          },
          "question_groups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["group_id", "questions"],
              "properties": {
                "group_id": {
                  "type": "string",
                  "description": "题组ID"
                },
                "materials": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "text": {"type": "string"},
                      "images": {
                        "type": "array",
                        "items": {"type": "string"}
                      },
                      "tables": {"type": "array"},
                      "notes": {"type": "array"}
                    }
                  }
                },
                "instruction": {
                  "type": "string",
                  "description": "引导语"
                },
                "questions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["question_number", "question_type"],
                    "properties": {
                      "question_number": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "题号"
                      },
                      "question_type": {
                        "type": "string",
                        "enum": ["选择题", "非选择题"],
                        "description": "题目类型"
                      },
                      "stem": {
                        "type": "string",
                        "description": "题干内容"
                      },
                      "sub_options": {
                        "type": "array",
                        "items": {"type": "string"},
                        "description": "子选项"
                      },
                      "options": {
                        "type": "object",
                        "properties": {
                          "A": {"type": "string"},
                          "B": {"type": "string"},
                          "C": {"type": "string"},
                          "D": {"type": "string"}
                        },
                        "required": ["A", "B", "C", "D"]
                      },
                      "sub_questions": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "sub_number": {"type": "integer"},
                            "text": {"type": "string"}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "string",
      "enum": ["ai", "script", "merged"],
      "description": "结果来源"
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "failed"],
      "description": "置信度"
    }
  }
}