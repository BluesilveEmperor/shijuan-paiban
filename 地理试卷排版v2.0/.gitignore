# Python缓存文件
__pycache__/
*.py[cod]
*$py.class
*.so

# 输出文件（运行时生成）
output/*.docx
output/*.json
output/*.txt
output/*.html

# 临时文件
*.tmp
*.temp
*.bak
*.swp
*~

# IDE配置
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# 日志文件（可选保留）
# *.log

# 测试和调试文件
test/
debug/
*.test.py

# 打包文件
*.skill
dist/
build/

# 环境配置（如果使用虚拟环境）
venv/
env/
.env

# 备份文件
backup/
*.backup

# 文档草稿（可选）
# docs/草稿*.md

# 参考试卷（重要，不忽略）
# 参考/*.docx