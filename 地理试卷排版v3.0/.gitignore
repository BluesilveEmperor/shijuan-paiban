# Python缓存文件
__pycache__/
*.py[cod]
*$py.class
*.so

# 输出产物（gitignore，README.md 除外）
output/
!output/README.md

# 临时文件
*.tmp
*.temp
*.bak
*.swp
*~

# 清洗过程生成的待识别符号图片（应在output目录中，不提交）
pending_images/
pending_images.json

# IDE配置
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# 打包文件
dist/
build/

# 环境配置
venv/
env/
.env

# 备份文件
backup/
*.backup
