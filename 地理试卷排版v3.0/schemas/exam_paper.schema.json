{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "地理试卷排版统一数据契约",
  "description": "v3.0 六步解耦流水线的统一数据格式。覆盖从结构打标到图片映射到排版的全链路数据。",
  "type": "object",
  "required": ["meta", "document", "images", "image_mapping", "validation"],
  "properties": {
    "meta": {
      "type": "object",
      "description": "试卷元信息",
      "required": ["title", "subject", "source_file"],
      "properties": {
        "title": {
          "type": "string",
          "description": "试卷标题，如'2025年普通高等学校招生全国统一考试（新课标卷）'"
        },
        "subtitle": {
          "type": "string",
          "description": "副标题（可选）"
        },
        "subject": {
          "type": "string",
          "description": "科目名称",
          "enum": ["地理"]
        },
        "grade": {
          "type": "string",
          "description": "年级/学段，如'高三'、'高考'"
        },
        "source_file": {
          "type": "string",
          "description": "原始试卷文件路径"
        },
        "notes": {
          "type": "string",
          "description": "试卷说明/注意事项全文（兼容旧格式，新格式使用 notes_items）"
        },
        "notes_items": {
          "type": "array",
          "description": "注意事项的结构化条目数组（新格式）",
          "items": {
            "type": "object",
            "required": ["type", "content"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["title", "item"],
                "description": "条目类型：title 为注意事项标题（如'注意事项'），item 为具体条目（如'1.作答前...'）"
              },
              "content": {
                "type": "string",
                "description": "条目内容"
              },
              "number": {
                "type": "string",
                "description": "条目标号（如'1'、'2'），仅 type=item 时有值"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "document": {
      "type": "object",
      "description": "试卷文档结构",
      "required": ["sections", "unclassified_blocks"],
      "properties": {
        "sections": {
          "type": "array",
          "description": "试卷分区（如选择题区、非选择题区）",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "type", "title", "questions"],
            "properties": {
              "id": {
                "type": "string",
                "description": "分区唯一标识，如'section_01'",
                "pattern": "^section_\\d{3}$"
              },
              "type": {
                "type": "string",
                "description": "分区类型",
                "enum": ["选择题", "非选择题", "填空题", "综合题"]
              },
              "title": {
                "type": "string",
                "description": "分区标题，如'一、选择题'"
              },
              "instructions": {
                "type": "array",
                "description": "分区说明/引导语",
                "items": { "type": "string" }
              },
              "questions": {
                "type": "array",
                "description": "该分区下的题目列表",
                "minItems": 1,
                "items": { "$ref": "#/definitions/question" }
              }
            },
            "additionalProperties": false
          }
        },
        "unclassified_blocks": {
          "type": "array",
          "description": "无法归类的文本块（兜底字段，空数组表示全部归类成功）",
          "items": {
            "type": "object",
            "required": ["id", "text", "reason"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^unclassified_\\d{3}$"
              },
              "text": {
                "type": "string",
                "description": "无法归类的原始文本"
              },
              "reason": {
                "type": "string",
                "description": "无法归类的原因",
                "enum": [
                  "题号丢失或乱序",
                  "选项与题干粘连",
                  "多栏文本串行化",
                  "表格被拆成纯文本",
                  "OCR识别异常",
                  "格式严重混乱",
                  "未知结构"
                ]
              },
              "notes": {
                "type": "string",
                "description": "补充说明"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "images": {
      "type": "array",
      "description": "图片理解结果列表",
      "items": {
        "type": "object",
        "required": ["image_id", "file_name", "type", "summary", "keywords", "uncertain"],
        "properties": {
          "image_id": {
            "type": "string",
            "description": "图片唯一标识",
            "pattern": "^img_\\d{3}$"
          },
          "file_name": {
            "type": "string",
            "description": "图片文件名（含扩展名），如'1.png'"
          },
          "type": {
            "type": "string",
            "description": "图片类型",
            "enum": [
              "地图",
              "统计图表",
              "示意图",
              "景观图",
              "卫星图",
              "表格图",
              "等高线图",
              "剖面图",
              "流程图",
              "其他"
            ]
          },
          "summary": {
            "type": "string",
            "description": "图片内容摘要"
          },
          "keywords": {
            "type": "array",
            "description": "关键词列表",
            "items": { "type": "string" }
          },
          "ocr_text": {
            "type": "array",
            "description": "OCR识别出的文字",
            "items": { "type": "string" }
          },
          "discipline_features": {
            "type": "array",
            "description": "学科特征标签（如'等值线'、'区域定位'、'气候类型'）",
            "items": { "type": "string" }
          },
          "clues": {
            "type": "array",
            "description": "与试题可能相关的线索",
            "items": { "type": "string" }
          },
          "uncertain": {
            "type": "boolean",
            "description": "图片理解是否不确定（兜底字段）"
          }
        },
        "additionalProperties": false
      }
    },

    "image_mapping": {
      "type": "array",
      "description": "占位符→图片的映射表",
      "items": {
        "type": "object",
        "required": ["placeholder_id", "image_id", "confidence", "reason"],
        "properties": {
          "placeholder_id": {
            "type": "string",
            "description": "引用的占位符ID",
            "pattern": "^ph_\\d{3}$"
          },
          "image_id": {
            "type": "string",
            "description": "引用的图片ID",
            "pattern": "^img_\\d{3}$"
          },
          "confidence": {
            "type": "number",
            "description": "映射置信度 0.0~1.0",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "reason": {
            "type": "string",
            "description": "匹配依据说明"
          }
        },
        "additionalProperties": false
      }
    },

    "validation": {
      "type": "object",
      "description": "校验信息",
      "required": ["has_unmapped_placeholders", "has_unused_images", "unmapped_placeholders", "unused_images", "warnings"],
      "properties": {
        "has_unmapped_placeholders": {
          "type": "boolean",
          "description": "是否有未映射的占位符"
        },
        "has_unused_images": {
          "type": "boolean",
          "description": "是否有未使用的图片"
        },
        "unmapped_placeholders": {
          "type": "array",
          "description": "未映射的占位符ID列表",
          "items": { "type": "string" }
        },
        "unused_images": {
          "type": "array",
          "description": "未使用的图片ID列表",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "description": "警告信息列表",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,

  "definitions": {
    "question": {
      "type": "object",
      "description": "单道题目",
      "required": ["id", "number", "stem", "question_type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "题目唯一标识",
          "pattern": "^question_\\d{3}$"
        },
        "number": {
          "type": "string",
          "description": "题号（可能含括号），如'1'、'(1)'"
        },
        "question_type": {
          "type": "string",
          "description": "题目类型",
          "enum": ["选择题", "非选择题", "填空题"]
        },
        "stem": {
          "type": "string",
          "description": "题干内容（不含占位符的纯文本，占位符在placeholders中）"
        },
        "materials": {
          "type": "array",
          "description": "题目材料（如材料题中的大段阅读材料）",
          "items": {
            "type": "object",
            "required": ["id", "content"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^material_\\d{3}(_\\d+)?$"
              },
              "content": {
                "type": "string",
                "description": "材料正文（不包含引导语）"
              },
              "guide_sentence": {
                "type": "string",
                "description": "材料末尾的引导语句，如'据此完成下面小题'、'完成下列要求'等，用于紧跟材料后单独设置字体样式"
              }
            },
            "additionalProperties": false
          }
        },
        "options": {
          "type": "array",
          "description": "选项列表（选择题必需）",
          "items": {
            "type": "object",
            "required": ["label", "text"],
            "properties": {
              "label": {
                "type": "string",
                "description": "选项标签，如'A'、'B'"
              },
              "text": {
                "type": "string",
                "description": "选项内容"
              }
            },
            "additionalProperties": false
          }
        },
        "subquestions": {
          "type": "array",
          "description": "子问题（大题下的小问）",
          "items": {
            "type": "object",
            "required": ["id", "label", "stem"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^subq_\\d{3}(_\\d+)?$"
              },
              "label": {
                "type": "string",
                "description": "小问标签，如'(1)'、'(2)'"
              },
              "stem": {
                "type": "string",
                "description": "小问题干"
              }
            },
            "additionalProperties": false
          }
        },
        "placeholders": {
          "type": "array",
          "description": "该题关联的图片占位符",
          "items": {
            "type": "object",
            "required": ["placeholder_id", "token", "location_type", "owner_id", "context_before", "context_after", "reason"],
            "properties": {
              "placeholder_id": {
                "type": "string",
                "description": "占位符唯一标识",
                "pattern": "^ph_\\d{3}$"
              },
              "token": {
                "type": "string",
                "description": "占位符标记文本",
                "pattern": "^\\{\\{image:ph_\\d{3}\\}\\}$"
              },
              "location_type": {
                "type": "string",
                "description": "占位符所在位置类型",
                "enum": ["title", "material", "question_stem", "subquestion", "option"]
              },
              "owner_id": {
                "type": "string",
                "description": "占位符所属节点的ID（question.id / material.id / subq.id）"
              },
              "context_before": {
                "type": "string",
                "description": "占位符前文（20字以内）"
              },
              "context_after": {
                "type": "string",
                "description": "占位符后文（20字以内）"
              },
              "reason": {
                "type": "string",
                "description": "插入占位符的依据（如'正文提到如图'、'题干含等值线判读需要插图'）"
              },
              "uncertain": {
                "type": "boolean",
                "description": "占位是否不确定（无法确定此处是否需要图片）",
                "default": false
              }
            },
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "string",
          "description": "打标备注（当 uncertain 时必填）"
        },
        "uncertain": {
          "type": "boolean",
          "description": "该题结构识别是否不确定（兜底字段）",
          "default": false
        }
      },
      "additionalProperties": false
    }
  }
}
